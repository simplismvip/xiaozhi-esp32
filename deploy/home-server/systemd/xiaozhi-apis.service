[Unit]
Description=xiaozhi-apis weather/TH HTTP service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ming
WorkingDirectory=/home/ming/apps/xiaozhi-apis
ExecStart=/home/ming/apps/xiaozhi-apis/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 3030
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
