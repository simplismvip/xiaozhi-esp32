{
    "name": "my-voice-board",
    "type": "my-voice-board",
    "version": "1.0.0",
    "target": "esp32s3",
    "description": "Custom voice assistant board: ESP32-S3 N16R8 + INMP441 + MAX98357A + ST7789/OLED",
    "builds": [
        {
            "name": "my-voice-board",
            "sdkconfig_append": [
                "CONFIG_MY_VOICE_DISPLAY_SPI_LCD=y",
                "CONFIG_MY_VOICE_LCD_ST7789_240X320=y",
                "CONFIG_OTA_URL=\"http://192.168.1.9:8003/xiaozhi/ota/\"",
                "CONFIG_HOME_ENV_URL=\"http://192.168.1.9:3030/api/weather\"",
                "CONFIG_USE_MUSIC_PLAYER=y",
                "CONFIG_MUSIC_GENER_BASE_URL=\"http://192.168.1.9:3020\""
            ]
        }
    ]
}
